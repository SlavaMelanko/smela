{
  "name": "@smela/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./src/config.js",
    "./env": "./src/env.js",
    "./api": "./src/api.js",
    "./email": "./src/email/index.js",
    "./actions": "./src/actions/index.js"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "format": "prettier --cache --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --cache --write . --ignore-path ../../.prettierignore",
    "lint": "eslint --cache src",
    "lint:fix": "eslint --cache src --fix",
    "lint:staged": "lint-staged",
    "check": "bun run format:fix && bun run lint:fix"
  },
  "lint-staged": {
    "*.js": [
      "eslint --max-warnings=0 --fix",
      "prettier --ignore-unknown --write"
    ]
  },
  "peerDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "dependencies": {
    "mailisk": "^2.5.1"
  },
  "devDependencies": {
    "@smela/eslint": "workspace:*"
  }
}
