{
  "name": "@smela/emails",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "email dev --dir src --port 3001",
    "format": "prettier --cache --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --cache --write . --ignore-path ../../.prettierignore",
    "lint": "eslint --cache src",
    "lint:fix": "eslint --cache src --fix",
    "lint:staged": "lint-staged",
    "tsc": "tsc",
    "test": "bun test src",
    "coverage": "bun test src --coverage",
    "check": "bun run format:fix && bun run lint:fix && bun run tsc && bun run test"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --ignore-unknown --write"
    ],
    "*.json": [
      "prettier --ignore-unknown --write"
    ],
    "*.md": [
      "prettier --ignore-unknown --write"
    ]
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "nodemailer": "^10.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.5",
    "@smela/eslint": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react-email": "^6.11.5"
  }
}
