{
  "name": "@smela/emails",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "email dev --dir src --port 3001",
    "format": "prettier --cache --check .",
    "format:fix": "prettier --cache --write .",
    "lint": "eslint --cache src",
    "lint:fix": "eslint --cache --fix src",
    "lint:staged": "lint-staged",
    "tsc": "bunx tsc",
    "test": "bun test src",
    "coverage": "bun test src --coverage",
    "check": "bun run format:fix && bun run lint:fix && bun run tsc && bun run test"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bunx prettier --write",
      "bunx eslint --cache --fix"
    ],
    "*.json": [
      "bunx prettier --write"
    ]
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.2.10",
    "@react-email/ui": "6.9.1",
    "@smela/eslint": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react-email": "^6.9.1"
  }
}
