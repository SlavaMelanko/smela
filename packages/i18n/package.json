{
  "name": "@smela/i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./resources": "./src/resources.js"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "format": "prettier --cache --check .",
    "format:fix": "prettier --cache --write .",
    "lint": "eslint --cache src scripts",
    "lint:fix": "eslint --cache src scripts --fix",
    "lint:staged": "lint-staged",
    "locales:sort": "sort-json src/resources/*.json",
    "check": "bun run locales:sort && bun run format:fix && bun run lint:fix",
    "sync": "bun scripts/sync.js",
    "sync:watch": "bun scripts/sync.js --watch"
  },
  "lint-staged": {
    "*.js": [
      "eslint --max-warnings=0 --fix",
      "prettier --ignore-unknown --write"
    ],
    "src/resources/*.json": [
      "sort-json"
    ]
  },
  "peerDependencies": {
    "i18next": "^26.3.6"
  },
  "devDependencies": {
    "@smela/eslint": "workspace:*",
    "chokidar": "^5.0.0",
    "sort-json": "^2.0.1"
  }
}
