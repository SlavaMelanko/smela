{
  "name": "@smela/api",
  "version": "2026.06.02",
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "bun --watch src/app.ts",
    "build": "NODE_ENV=production bun build src/app.ts --outdir dist --target bun --minify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:custom": "bun src/data/migrations/custom/run.ts",
    "db:seed": "bun src/data/scripts/seed.ts",
    "db:init": "bun run db:generate && bun run db:migrate && bun run db:migrate:custom && bun run db:seed",
    "db:dev:up": "docker compose -f docker-compose-dev.yml --env-file .env.development up -d --wait",
    "db:dev:down": "docker compose -f docker-compose-dev.yml --env-file .env.development down -v",
    "db:dev:reset": "bun run db:dev:down && bun run db:dev:up && bun run db:init",
    "db:ui": "drizzle-kit studio",
    "format": "bunx prettier --cache --check src",
    "format:fix": "bunx prettier --cache --write src",
    "lint": "bunx eslint --cache src",
    "lint:fix": "bunx eslint --cache --fix src",
    "lint:staged": "lint-staged",
    "tsc": "bunx tsc --noEmit",
    "test": "NODE_ENV=test bun test src",
    "coverage": "NODE_ENV=test bun test src --coverage",
    "check": "bun run format:fix && bun run lint:fix && bun run tsc && bun run test",
    "emails": "email dev --dir src/emails --port 3001"
  },
  "lint-staged": {
    "*.ts": [
      "bunx prettier --write",
      "bunx eslint --cache --fix"
    ],
    "*.json": [
      "bunx prettier --write"
    ]
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@react-email/components": "^1.0.12",
    "@sentry/bun": "^10.69.0",
    "@smela/contracts": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "hono-pino": "^0.10.3",
    "hono-rate-limiter": "^0.5.3",
    "http-status-codes": "^2.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@react-email/preview-server": "^5.2.10",
    "@smela/eslint": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "nodemailer": "^9.0.3",
    "pino-pretty": "^13.1.3",
    "react-email": "^6.9.1"
  }
}
