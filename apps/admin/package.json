{
  "name": "@smela/admin",
  "private": true,
  "version": "2026.06.02",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules",
    "dev": "vite --mode development --port 5175",
    "preview": "vite preview --mode production --port 5175",
    "build": "vite build --mode production",
    "format": "prettier --cache --check .",
    "format:fix": "prettier --cache --write .",
    "lint": "eslint --cache src e2e",
    "lint:fix": "eslint --cache src e2e --fix",
    "lint:staged": "lint-staged",
    "check": "bun run format:fix && bun run lint:fix",
    "e2e": "NODE_ENV=test playwright test -x",
    "e2e:ui": "NODE_ENV=test playwright test --ui",
    "bundle:analyze": "ANALYZE_BUNDLE=true bun run build"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --ignore-unknown --write"
    ]
  },
  "dependencies": {
    "@smela/ui": "workspace:*",
    "@smela/i18n": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@smela/eslint": "workspace:*",
    "@smela/e2e": "workspace:*",
    "@faker-js/faker": "^10.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "rollup-plugin-webpack-stats": "^3.1.3",
    "vite": "^8.2.0"
  }
}
